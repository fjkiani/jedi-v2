# Netlify / Cloudflare Pages headers file
# ---------------------------------------
# Placed at public/_headers, copied to dist/ at build time.
# Netlify docs: https://docs.netlify.com/routing/headers/
# Cloudflare Pages docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# Strategy:
#   * /assets/*  — Vite emits content-hashed filenames, so cache immutably for 1 year
#   * *.js / *.css at root — same deal (Vite output)
#   * /og/*, /images/*, /videos/* — long cache, occasional invalidation via rename
#   * *.html — short cache, must-revalidate (prerendered HTML changes on every deploy)
#   * /sitemap.xml, /robots.txt, /llms.txt — short cache
#   * All routes — strict security headers (HSTS, X-Content-Type-Options, Referrer-Policy)

# Content-hashed Vite assets — immutable, 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Static media — long cache
/og/*
  Cache-Control: public, max-age=2592000
/images/*
  Cache-Control: public, max-age=2592000
/videos/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Config / discovery files — short cache
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# Service worker — never cache (must fetch fresh so users get updates immediately)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# All routes — security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # CSP intentionally omitted from the platform-agnostic file — the site loads
  # inline scripts, fonts.gstatic, Hygraph API, HuggingFace, and Google Analytics.
  # A working CSP is deployment-specific; add it after you audit third-party origins.
