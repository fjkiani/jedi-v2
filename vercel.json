    {"source": "/blog/building-web3", "destination": "/blog/post/building-web3", "permanent": true},
    {"source": "/blog/graph-rag", "destination": "/blog/post/graph-rag", "permanent": true},
    {"source": "/blog/knowledge-graph", "destination": "/blog/post/knowledge-graph", "permanent": true},
    {"source": "/blog/supabase-etl", "destination": "/blog/post/supabase-etl", "permanent": true},
    {"source": "/blog/ora-hackathon", "destination": "/blog/post/ora-hackathon", "permanent": true},
    {"source": "/blog/evo-2", "destination": "/blog/post/evo-2", "permanent": true},
    {"source": "/blog/jedilabs", "destination": "/blog/post/jedilabs", "permanent": true},
    {"source": "/blog/identity-missing-pillar-agentic-ai", "destination": "/blog/post/identity-missing-pillar-agentic-ai", "permanent": true}
