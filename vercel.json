{
  "version": 2,
  "builds": [
    {"src": "server/server.js", "use": "@vercel/node", "config": {"includeFiles": ["dist/**"]}},
    {"src": "package.json", "use": "@vercel/static-build", "config": {"distDir": "dist"}}
  ],
  "routes": [
    {"src": "/blog/post/.*", "dest": "server/server.js"},
    {"src": "/assets/(.*)", "dest": "/dist/assets/$1"},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "server/server.js"}
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
